# Dashboard
HOST=127.0.0.1
PORT=8090
# Optional shared token for the dashboard API. Leave blank for local-only use.
DASHBOARD_TOKEN=

# Companion hosts (JSON array). The first host is the default.
# kind: production | lab | synthetic
COMPANION_HOSTS=[{"id":"synthetic","name":"Synthetic campus","baseUrl":"","kind":"synthetic"}]
# Example live hosts:
# COMPANION_HOSTS=[{"id":"prod","name":"Campus production","baseUrl":"http://192.0.2.10:8000","kind":"production"},{"id":"lab","name":"Lab 5.1","baseUrl":"http://127.0.0.1:8000","kind":"lab"}]

# Read-only adapter
COMPANION_TIMEOUT_MS=8000

# OpenAI-compatible advisory AI. Leave the key blank to use the offline KB fallback.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2

# Build engine output schema: 9 (Companion 4.2.5) or 12 (Companion 5.x)
BUILD_SCHEMA=12
